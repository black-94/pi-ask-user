{
  "name": "pi-ask-user",
  "version": "0.1.0",
  "description": "AskUser - a route-forced ask-user interaction component/tool for Pi extensions (custom TUI or native dialogs)",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "extension",
    "ask_user",
    "AskUser",
    "interactive"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "exports": {
    ".": "./index.ts",
    "./types": "./src/types.ts"
  },
  "files": [
    "index.ts",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run test"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.87.0",
    "@earendil-works/pi-tui": ">=0.87.0",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@earendil-works/pi-tui": "0.87.1",
    "@types/node": "22.10.2",
    "typebox": "1.3.27",
    "typescript": "5.9.3"
  }
}
